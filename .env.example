# Neon/PostgreSQL connection string. Keep this only on the server side.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Required in production. Used to sign admin session tokens returned by /api/admin/login.
ADMIN_TOKEN_SECRET="replace-with-a-long-random-secret"

# Optional seed overrides. If omitted, npm run init-db creates the default admin
# requested for NutriMeet and stores only a bcrypt password hash.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="temporary-password-used-only-when-running-init-db"
# ADMIN_PASSWORD_HASH="$2b$12$..."

# Optional PostgreSQL pool tuning.
# PG_POOL_MAX="1"
# PGSSL="true"

# GEMINI_API_KEY: Required for Gemini AI API calls when AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="MY_APP_URL"
